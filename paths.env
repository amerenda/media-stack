# Non-secret host paths and settings consumed by compose.yaml.
# SQLite-backed configs live on the NVMe (/opt); the rest on the RAID array.
# The directories themselves are provisioned by Ansible, not by this repo.
CONFIG_BASE=/mnt/storage/media/config
JELLYFIN_CONFIG=/opt/jellyfin-config
SEERR_CONFIG=/opt/seerr-config
BAZARR_CONFIG=/opt/bazarr-config
CALIBREWEB_CONFIG=/opt/calibre-web-config
PROFILARR_CONFIG=/opt/profilarr-config
PROWLARR_CONFIG=/opt/prowlarr-config
RADARR_CONFIG=/opt/radarr-config
SABNZBD_CONFIG=/opt/sabnzbd-config
SHELFARR_CONFIG=/opt/shelfarr-config
SONARR_CONFIG=/opt/sonarr-config
MAINTAINERR_CONFIG=/opt/maintainerr-config
CALIBRE_CONFIG=/mnt/storage/media/config/calibre/config
BOOKORBIT_DATA_FOLDER=/mnt/storage/media/config/bookorbit/data
BOOKORBIT_POSTGRES_DATA=/mnt/storage/media/config/bookorbit/postgres
BOOKORBIT_MIGRATION_IMPORTS_FOLDER=/mnt/storage/media/config/bookorbit/imports
BOOKORBIT_APP_URL=https://bookorbit.media.amer.dev
BOOKS_LIBRARY_ROOT=/mnt/storage/books/library
BOOKS_LIBRARY_EBOOKS_FOLDER=/mnt/storage/books/library/ebooks
BOOKS_LIBRARY_AUDIOBOOKS_FOLDER=/mnt/storage/books/library/audiobooks
BOOKS_LIBRARY_COMICS_FOLDER=/mnt/storage/books/library/comics
CALIBRE_LIBRARY_FOLDER=/mnt/storage/books/calibre-library
MOVIES_FOLDER=/mnt/storage/movies
TV_FOLDER=/mnt/storage/tv
DISCOVER_FOLDER=/mnt/storage/discover
USENET_DOWNLOADS=/mnt/storage/downloads/complete
USENET_DOWNLOADS_INCOMPLETE=/mnt/storage/downloads/incomplete
TRANSCODE_FOLDER=/mnt/storage/cache/transcode
JELLYFIN_URL=http://10.100.20.19:8096
